# 复制为 deploy/.env.prod 并修改密码（勿提交 .env.prod）

# 对外域名（用于 CORS；须与 DNS / Nginx server_name 一致）
TP_HOST=tp.textengine.cn
CORS_ORIGINS=https://tp.textengine.cn

# 本机端口。清嘉录容器经 host.docker.internal 反代时须 QTS_HTTP_BIND=0.0.0.0（安全组勿对公网开放 18080）
QTS_HTTP_BIND=0.0.0.0
QTS_HTTP_PORT=18080

# 对外 HTTPS：为 tp 单独公网 IP，DNS 的 tp A 记录指向该 IP（与清嘉录 IP 分开即可不抢 443）
# QTS_PUBLIC_IP=43.142.176.x
# QTS_CERT_DIR=/data/qts/cert

# PostgreSQL
POSTGRES_USER=qts
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=quatangshi
PGDATA_HOST_PATH=/data/qts/pgdata

# Meilisearch
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_INDEX=quatangshi
MEILI_DATA_PATH=/data/qts/meili
