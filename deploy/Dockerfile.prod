# 生产镜像：web 静态资源 + FastAPI + 一次性索引导入
# 构建（项目根）：docker compose -f deploy/docker-compose.prod.yml build

ARG NODE_IMAGE=node:22-bookworm-slim
ARG PYTHON_IMAGE=python:3.12-slim-bookworm

# ---------- 前端 ----------
FROM ${NODE_IMAGE} AS web-builder
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

# ---------- API ----------
FROM ${PYTHON_IMAGE} AS api
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-search.txt apps/api/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r apps/api/requirements.txt

COPY apps/api/ ./apps/api/
COPY tools/corpus_paths.py tools/sync_postgres.py tools/build_meilisearch_index.py ./tools/
COPY index/quatangshi_phase1.jsonl ./index/quatangshi_phase1.jsonl
COPY db/schema.sql ./db/schema.sql

ENV PYTHONPATH=/app
WORKDIR /app/apps/api

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ---------- 首次导入索引（profile: bootstrap）----------
FROM api AS bootstrap
WORKDIR /app
CMD ["sh", "-c", "python tools/sync_postgres.py && python tools/build_meilisearch_index.py --recreate"]

# ---------- Nginx 静态 + API 反代 ----------
FROM nginx:1.27-alpine AS web
COPY deploy/nginx.docker.conf /etc/nginx/conf.d/default.conf
COPY --from=web-builder /app/dist /usr/share/nginx/html
EXPOSE 80
